{
  "name": "notebook-desktop",
  "productName": "notebook",
  "version": "1.0.0",
  "description": "NotebookLM 风格的学习助手桌面版",
  "main": "main.cjs",
  "private": true,
  "homepage": "https://github.com/AiMac Dmitry/notebook",
  "author": {
    "name": "AiMac Dmitry",
    "email": "aimac.dmitry@yandex.ru"
  },
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.notebook.app",
    "productName": "notebook",
    "files": ["main.cjs", "preload.cjs"],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": false,
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "win": {
      "target": ["portable"],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.education",
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "app/**/*.py",
          "requirements.txt",
          "data/tocs.json"
        ]
      },
      {
        "from": "tools/python",
        "to": "python",
        "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc"]
      },
      {
        "from": "tools/pydeps",
        "to": "python/pydeps",
        "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc"]
      },
      {
        "from": "../frontend/.next/standalone",
        "to": "frontend"
      },
      {
        "from": "tools/node",
        "to": "bin/node"
      },
      {
        "from": "tools/node.exe",
        "to": "bin/node.exe"
      }
    ]
  }
}