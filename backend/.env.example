# 对话：DeepSeek（OpenAI 兼容端点）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 填入你的 DeepSeek API Key（sk-...）
DEEPSEEK_API_KEY=
CHAT_MODEL=deepseek-chat

# 向量化：本地 fastembed（bge-small-zh，约 100MB，CPU 离线推理）
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 备选：若用 OpenAI 兼容的 embedding API，把 EMBEDDING_PROVIDER 改为 openai 并填下面这两项
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_API_KEY=
# EMBEDDING_MODEL=BAAI/bge-m3

# 切块参数
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
TOP_K=5

# 数据库文件位置（留空则用 backend/data/app.db）
# DB_PATH=
# 后端端口（留空则 8000）
# PORT=8000